# Local MySQL configuration (example values only; never commit real credentials)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/threadflow?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=threadflow_app
SPRING_DATASOURCE_PASSWORD=replace-with-a-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
THREADFLOW_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
THREADFLOW_JWT_EXPIRATION_MINUTES=480
THREADFLOW_COOKIE_SECURE=true
THREADFLOW_COOKIE_SAME_SITE=Lax
SPRING_PROFILES_ACTIVE=local
THREADFLOW_DEMO_MERCHANDISER_EMAIL=merchandiser@local.threadflow
THREADFLOW_DEMO_MERCHANDISER_PASSWORD=replace-with-a-local-password-at-least-12-characters
THREADFLOW_DEMO_SUPERVISOR_EMAIL=supervisor@local.threadflow
THREADFLOW_DEMO_SUPERVISOR_PASSWORD=replace-with-a-local-password-at-least-12-characters
THREADFLOW_AI_BASE_URL=
THREADFLOW_AI_API_KEY=
THREADFLOW_AI_MODEL=
THREADFLOW_AI_TIMEOUT_MILLIS=5000
